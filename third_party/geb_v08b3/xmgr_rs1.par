#move g0.s0 to g0.s0
move g0.s1 to g1.s0
move g0.s2 to g2.s0
move g0.s3 to g3.s0
move g0.s4 to g4.s0
#
#for2sets: move g0.s5 to g0.s2
#for2sets: move g0.s6 to g1.s2
#for2sets: move g0.s7 to g2.s2
#for2sets: move g0.s8 to g3.s2
#for2sets: move g0.s9 to g4.s2
with g0
    yaxis label "Total activity"
    view xmin 0.15
    view xmax 0.9
    view ymin 0.810
    view ymax 0.990
    xaxis  ticklabel off
    xaxis  tick major off
    yaxis  tick major off
    yaxis  label place spec
    yaxis  label place 0.12, 0
#    yaxis  label char size 0.68
    yaxis  label char size 0.8
#    xaxis  label char size 0.8
#    xaxis label "Time"
with g1
#    yaxis label "Mean activity"
    yaxis label "Mean act."
    view xmin 0.15
    view xmax 0.9
    view ymin 0.630
    view ymax 0.810
    xaxis  ticklabel off
    xaxis  tick major off
    yaxis  tick major off
    yaxis  label place spec
    yaxis  label place 0.12, 0
#    yaxis  label char size 0.68
    yaxis  label char size 0.8
#    xaxis  label char size 0.8
#    xaxis label "Time"
with g4
#    yaxis label "Median activity"
    yaxis label "Median act."
    view xmin 0.15
    view xmax 0.9
    view ymin 0.450
    view ymax 0.630
    xaxis  ticklabel off
    xaxis  tick major off
    yaxis  tick major off
    yaxis  label place spec
    yaxis  label place 0.12, 0
#    yaxis  label char size 0.68
    yaxis  label char size 0.8
#    xaxis  label char size 0.8
#    xaxis label "Time"
with g2
#    yaxis label "Mean new activity"
    yaxis label "Mean new act."
    view xmin 0.15
    view xmax 0.9
    view ymin 0.270
    view ymax 0.450
    xaxis  ticklabel off
    xaxis  tick major off
    yaxis  tick major off
    yaxis  label place spec
    yaxis  label place 0.12, 0
#    yaxis  label char size 0.68
    yaxis  label char size 0.8
#    xaxis  label char size 0.8
#    xaxis label "Time"
with g3
    yaxis label "Diversity"
    view xmin 0.15
    view xmax 0.9
    view ymin 0.090
    view ymax 0.270
#    xaxis  ticklabel off
    xaxis  tick major off
    yaxis  tick major off
    yaxis  label place spec
    yaxis  label place 0.12, 0
#    yaxis  label char size 0.68
    yaxis  label char size 0.8
#    xaxis  label char size 0.8
    xaxis  label place spec
    xaxis  label place 0, 0.075
    xaxis label "Time"
###################################################
with g0
    runavg(s0,1000)
#    s0 ignore
    s0 color 1
    s1 color 0
    s1 linestyle 1
    s1 linewidth 2
with g1
    runavg(s0,1000)
#    s0 ignore
    s0 color 1
    s1 color 0
    s1 linestyle 1
    s1 linewidth 2
with g4
    runavg(s0,1000)
#    s0 ignore
    s0 color 1
    s1 color 0
    s1 linestyle 1
    s1 linewidth 2
with g2
    runavg(s0,1000)
#    s0 ignore
    s0 color 1
    s1 color 0
    s1 linestyle 1
    s1 linewidth 2
with g3
    runavg(s0,1000)
#    s0 ignore
    s0 color 1
    s1 color 0
    s1 linestyle 1
    s1 linewidth 2
