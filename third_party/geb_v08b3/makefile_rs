$(rulestatsPrerequisiteFiles) \
:	%	:	rulestatsPrerequisiteChecks compressOrUncompressRulestatsPrerequisiteFileIfRequired%

compressOrUncompressRulestatsPrerequisiteFileIfRequired%	:	
	@	f=`echo $@ | awk '{print substr($$0,1+length("compressOrUncompressRulestatsPrerequisiteFileIfRequired"))}'`; \
		if [ ! -f $$f ] ;then \
			if [ `echo $$f | awk -F\. '{print $$NF}'` == 'bz2' ] ;then \
				uf=`echo $$f | awk '{print substr($$0,1,length($$0)-4)}'`; if [ -f $$uf ] && [ ! -L $$uf ] ; then echo Compressing $$uf ; bzip2 $$uf ; fi ; \
			else	cf=$$f".bz2" ; if [ -f $$cf ] && [ ! -L $$cf ] ; then echo Uncompressing $$cf ; bunzip2 $$cf ; fi ; \
			fi; \
			if [ ! -f $$f ] ;then \
				echo ; echo ERROR: Prerequisite file $$f not found ; echo ; exit 99; \
			fi; \
		fi

compressOrUncompressAllRulestatsPrerequisiteFilesIfRequired	:
		for f in $(rulestatsPrerequisiteFiles) ;do if ! $(NonverboseMAKE) compressOrUncompressRulestatsPrerequisiteFileIfRequired$$f ;then exit 99 ;fi ;done

compressAllRulestatsPrerequisiteFilesIfPossibleAndNotAlready	:
		for f in $(rulestatsPrerequisiteFiles) ;do if [ ! -L $$f ] ; then \
			if [ `echo $$f | awk -F\. '{print $$NF}'` == 'bz2' ] ;then cf=$$f; else cf=$$f".bz2"; fi ; \
			if ! $(NonverboseMAKE) compressOrUncompressRulestatsPrerequisiteFileIfRequired$$cf ;then exit 99 ;fi ; \
		fi ; done

rulestatsPrerequisiteChecks	:	
		if [ -f autodetectResetsOrNoresets ] ;then \
			if [ -f autodetectResetsOrNoresets.toBeCheckedForConsistency ] && ! cmp -s autodetectResetsOrNoresets.toBeCheckedForConsistency autodetectResetsOrNoresets ;then \
				echo ; echo ERROR: autodetectResetsOrNoresets inconsistent with autodetectResetsOrNoresets.toBeCheckedForConsistency ; echo ; exit 99; \
			fi; \
			cp -p autodetectResetsOrNoresets autodetectResetsOrNoresets.toBeCheckedForConsistency ; \
		fi
		if ! $(NonverboseMAKE) cleanallrulestats ;then exit 99 ;fi ; echo
		if ! $(NonverboseMAKE) compressOrUncompressAllRulestatsPrerequisiteFilesIfRequired ;then exit 99 ;fi ; echo
		if ! $(NonverboseMAKE) verify ;then exit 99 ;fi ; echo
		if ! $(NonverboseMAKE) checkPseudoExtinction ;then exit 99 ;fi ; echo
		if [ -f autodetectResetsOrNoresets ] && ! cmp -s autodetectResetsOrNoresets.toBeCheckedForConsistency autodetectResetsOrNoresets ;then \
			echo ; echo ERROR: autodetectResetsOrNoresets inconsistent with previous version ; echo ; exit 99; \
		fi ; rm autodetectResetsOrNoresets.toBeCheckedForConsistency ; echo
		echo PrerequisiteChecks Were Successful > rulestatsPrerequisiteChecks ; echo

verify	:	
	echo ; for file in rulestat SHADOWrulestat ; do if [ -f $$file.verifier.bz2 ] ; then if ! awk 'BEGIN {error=0;getline;getline;getline;getline;getline} {a=b=c=d=0;t=1*substr($$1,1,length($$1)-1);for (n=2;n<=NF;n+=2) {dot=index($$n,".");a+=1*substr($$n,1,dot-1);b+=1*substr($$n,dot+1);c++;d+=1*substr($$(n+1),1,length($$(n+1))-1)} {"bzcat<'$$file'.verifier.bz2"|getline}; vt=1*substr($$1,1,length($$1)-1);va=$$2;vb=$$3;vc=$$4;vd=$$5; if (vt!=t || va!=a || vb!=b || vc!=c || vd!=d) {error=1; print "ERROR: Verification error found in '$$file' at t = "t" vt = "vt}} END {if (error) {print "ERROR: Verification of '$$file' FOUND ERRORS";exit 99} else print "Verification of '$$file' successful"}' $$file ;then exit 99 ;fi ; else echo ERROR: File $$file.verifier.bz2 not found; exit 99; fi ; done ; ( grep -n '[^[:print:]]' rulestat SHADOWrulestat | awk -F: '{print "ERROR: Line "$$2" of file "$$1" contains unprintable characters";exit 99}' )


checkPseudoExtinction	:	
	echo ; gebOutStatsEvery=`bzcat geb.out.bz2 | grep '^time: T' | head -1 | awk -FT '{print $$2}'`; \
	PseudoExtinctionRoof=30;PseudoExtinctionMinLength=`echo 10000 / $$gebOutStatsEvery | bc`;PseudoExtinctionIgnoreFirst=1000000; \
	pseudoExtinctionAt=`bzcat geb.out.bz2 | fgrep 'time: T' | awk -F[TN] 'BEGIN {eLength=0;eAt=0;while (getline&&!eAt) {t=$$2;n=$$4;if (n<'$$PseudoExtinctionRoof') {eLength++;if (eLength=='$$PseudoExtinctionMinLength' && lastHighT>'$$PseudoExtinctionIgnoreFirst') eAt=lastHighT} else {eLength=0;lastHighT=t}} print eAt}'`; \
	if [ $$pseudoExtinctionAt -ne 0 ] ;then \
		OUTPUTEVERY=`grep '^Output every ' rulestat | head -1 | awk '{print $$3}'`; \
		truncateTo=`echo $$OUTPUTEVERY \* \( $$pseudoExtinctionAt / $$OUTPUTEVERY \) | bc`; \
		echo ERROR: PseudoExtinction found - please truncate run to t=$$truncateTo; \
		echo ; exit 99; \
	else	echo PseudoExtinction check passed - no pseudoExtinction found - good; \
	fi

