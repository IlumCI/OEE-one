#File makefile_rs: Calculations of Evolutionary-Statistics from Neural-Network-L-Systems-Development-Rules-Existence-Statistics output during a run.

# *** You need to set the values for L and H (the new-activity range) manually - the default values are just examples.  ***

#This file has only been tested under GNU-Linux.
#To use: make -f makefile_rs ...
#Or: Uncomment the 'include makefile_rs' line in makefile and comment out the cleanallrulestats lines there.

#================================================================================

#Set run_used_reset_shadow_to_real_for_each_pass to one of no,yes,autodetect. 
#run_used_reset_shadow_to_real_for_each_pass=no
#run_used_reset_shadow_to_real_for_each_pass=yes
run_used_reset_shadow_to_real_for_each_pass=autodetect

#================================================================================

#Files required from run:
rulestatsPrerequisiteFiles = snapshot.geb geb.out.bz2 rulestat SHADOWrulestat rulestat.verifier.bz2 SHADOWrulestat.verifier.bz2
#You also need this file (makefile_rs) and xmgr_rs1.par & xmgr_rs2.par & xmgr_wav1.par & xmgr_wav2.par & xmgr_freq.par and xmgr & xmgrace for viewing

#================================================================================

#Specify what to do for a complete set of calculations:
#allrulestats	:	rulestats predbits compressAllRulestatsPrerequisiteFilesIfPossibleAndNotAlready
allrulestats	:	predbits compressAllRulestatsPrerequisiteFilesIfPossibleAndNotAlready
	
#rulestats	:	NORMrulestat.act.presence NORMrulestat.act.usage NORMrulestat.act.concentration BOTHANDDIFF.averagelengths
#rulestats	:	NORMrulestat.act.presence NORMrulestat.act.usage BOTHANDDIFF.averagelengths
rulestats	:	NORMrulestat.act.presence
	
#When run did not use reset_shadow_to_real_for_each_pass, the above creates all output files because NORMs require real and SHADOW files, and
#wave ("wav") & frequency ("freq") files are produced when main activity ("act") files are.
#
#When run did     use reset_shadow_to_real_for_each_pass, the above creates only the nomalised statistics (main+waves+frequency), and
#you should make rulestat.act.* to see the pre-normalised real data (and make SHADOWrulestat.act.* to see the shadow data, although this does not mean much).

#================================================================================

ifeq ($(run_used_reset_shadow_to_real_for_each_pass),autodetect)
run_used_reset_shadow_to_real_for_each_pass=$(shell if [ ! -f autodetectResetsOrNoresets ] ;then ( echo -n run_used_reset_shadow_to_real_for_each_pass=; if [ -f snapshot.geb ] || [ -f snapshot.geb.bz2 ] ;then SHADOWline=`if [ -f snapshot.geb ] ;then cat snapshot.geb ;else bzcat snapshot.geb.bz2 ;fi | grep '^SHADOWRulestat snapshot' | head -1`;if [ "$$SHADOWline" == "SHADOWRulestat snapshot:" ] ; then echo no ; else if [ "$$SHADOWline" == "SHADOWRulestat snapshot, extends those above (informational only - not needed for a restart):" ] ; then echo yes ; else echo ERROR:COULDNOTDETECT ;fi ;fi; else echo nosnapshot ;fi ) > autodetectResetsOrNoresets ; fi >>/dev/null 2>&1 ; awk -F= '{print $$2}' autodetectResetsOrNoresets)
ifeq ($(run_used_reset_shadow_to_real_for_each_pass),nosnapshot)
run_used_reset_shadow_to_real_for_each_pass=$(shell if [ -f rulestat ] || [ -f rulestat.bz2 ] ;then echo needsnapshot ;else echo NA; fi)
ifeq ($(run_used_reset_shadow_to_real_for_each_pass),needsnapshot)
$(error ERROR: You need snapshot.geb or snapshot.geb.bz2 in order to use autodetection of ResetsOrNoresets)
endif
endif
ifneq ($(run_used_reset_shadow_to_real_for_each_pass),NA)
ifneq ($(run_used_reset_shadow_to_real_for_each_pass),yes)
ifneq ($(run_used_reset_shadow_to_real_for_each_pass),no)
$(error Error in autodetection of ResetsOrNoresets $(run_used_reset_shadow_to_real_for_each_pass))
endif
endif
endif
endif

